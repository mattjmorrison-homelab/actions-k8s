#!/usr/bin/env bash

if [[ -n "${KUBECTL_CALL_LOG:-}" ]]; then
  echo "$*" >> "$KUBECTL_CALL_LOG"
fi

if [[ "$*" == *"create token"* ]]; then
  if [[ -n "${KUBECTL_TOKEN_SA_LOG:-}" ]]; then
    prev=""
    for arg in "$@"; do
      if [[ "$prev" == "token" ]]; then
        echo "$arg" > "$KUBECTL_TOKEN_SA_LOG"
      fi
      prev="$arg"
    done
  fi
  echo "fake-token"
  exit 0
fi

if [[ "$*" == *"apply -f"* ]]; then
  prev=""
  for arg in "$@"; do
    if [[ "$prev" == "-f" ]]; then
      cp "$arg" "${KUBECTL_APPLY_INPUT_FILE:-/dev/null}"
    fi
    prev="$arg"
  done
  exit 0
fi

if [[ "$*" == *"delete job"* ]]; then
  if [[ -n "${KUBECTL_DELETE_MARKER:-}" ]]; then
    echo "deleted" > "$KUBECTL_DELETE_MARKER"
  fi
  exit 0
fi

if [[ "$*" == *"get job"* && "$*" == *"status.failed"* ]]; then
  echo "${MOCK_JOB_FAILED:-}"
  exit 0
fi

if [[ "$*" == *"get pods"* ]]; then
  echo "${MOCK_POD_NAME:-}"
  exit 0
fi

# Checked before the generic "get pod " phase-check below, which would
# otherwise match this too and return a phase string ("Running") where
# an exit code is expected.
if [[ "$*" == *"get pod "* && "$*" == *"terminated.exitCode"* ]]; then
  echo "${MOCK_POD_EXIT_CODE:-}"
  exit 0
fi

# `kubectl wait ... --for=jsonpath=...terminated` on the pod: resolves
# (exit 0) the instant a terminated state would be observable. Driven by
# MOCK_POD_TERMINATED when set (lets a test simulate the wait succeeding
# independently of whether MOCK_POD_EXIT_CODE -- a separate, later `get
# pod ...exitCode` call -- comes back empty); otherwise falls back to
# MOCK_POD_EXIT_CODE's own truthiness, matching the old coupled
# behavior. On failure, writes MOCK_POD_WAIT_STDERR (or a stand-in
# timeout message, since real `kubectl wait` timeouts go to stderr too)
# and exits MOCK_POD_WAIT_EXIT, so tests can assert run-job.sh actually
# surfaces this instead of discarding it.
if [[ "$*" == *"wait pod"* && "$*" == *"terminated"* ]]; then
  if [[ -n "${MOCK_POD_TERMINATED:-${MOCK_POD_EXIT_CODE:-}}" ]]; then
    exit 0
  fi
  echo "${MOCK_POD_WAIT_STDERR:-error: timed out waiting for the condition on pods/mock}" >&2
  exit "${MOCK_POD_WAIT_EXIT:-1}"
fi

# `kubectl wait ... --for=jsonpath=...succeeded` on the job: resolves
# when MOCK_JOB_SUCCEEDED is truthy, otherwise times out (exit 1) --
# same semantics as the old status.succeeded poll, just event-driven. On
# failure, writes MOCK_JOB_WAIT_STDERR (or a stand-in timeout message)
# and exits MOCK_JOB_WAIT_EXIT, mirroring the pod-wait mock above.
if [[ "$*" == *"wait job"* && "$*" == *"succeeded"* ]]; then
  if [[ -n "${MOCK_JOB_SUCCEEDED:-}" ]]; then
    exit 0
  fi
  echo "${MOCK_JOB_WAIT_STDERR:-error: timed out waiting for the condition on jobs/mock}" >&2
  exit "${MOCK_JOB_WAIT_EXIT:-1}"
fi

# Deliberately distinct from "get pods" above -- "get pod " (singular,
# trailing space) never matches "get pods " since the "s" sits between
# "pod" and the space.
if [[ "$*" == *"get pod "* ]]; then
  count_file="${MOCK_PENDING_COUNTER_FILE:-}"
  n=0
  if [[ -n "$count_file" && -f "$count_file" ]]; then
    n=$(cat "$count_file")
  fi
  if [[ "$n" -lt "${MOCK_PENDING_COUNT:-0}" ]]; then
    [[ -n "$count_file" ]] && echo $((n + 1)) > "$count_file"
    echo "Pending"
  else
    echo "${MOCK_POD_PHASE:-Running}"
  fi
  exit 0
fi

if [[ "$*" == *"logs -f"* ]]; then
  if [[ -n "${KUBECTL_LOGS_MARKER:-}" ]]; then
    echo "logged" > "$KUBECTL_LOGS_MARKER"
  fi
  echo "fake pod logs"
  exit 0
fi

echo "unexpected kubectl call: $*" >&2
exit 1
